class Solution(object):
    def reverse(self, x):
        rev = 0
        sign = 1
        tmp = abs(x)
        if x < 0:
            sign = -1
            
        while tmp > 0:
            dig = tmp % 10
            rev = (rev * 10) + dig
            tmp //= 10
            
        result = sign * rev
        
        
        if result < -2**31 or result > 2**31 - 1:
            return 0
            
        return result
