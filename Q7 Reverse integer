class Solution(object):
    def reverse(self, x):
        rev = 0
        sign = 1
        tmp = abs(x)
        if x < 0:
            sign = -1
            
        while tmp > 0:
            dig = tmp % 10
            rev = (rev * 10) + dig
            tmp //= 10
            
        # 부호를 다시 붙여줌
        result = sign * rev
        
        # 🌟 여기서 32비트 정수 범위(-2^31 ~ 2^31 - 1) 체크!
        if result < -2**31 or result > 2**31 - 1:
            return 0
            
        return result
