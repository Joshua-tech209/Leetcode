class Solution(object):
    def setZeroes(self, matrix):
        """
        :type matrix: List[List[int]]
        :rtype: None Do not return anything, modify matrix in-place instead.
        """
        row, col = len(matrix), len(matrix[0])
        r, c=[1]*row, [1]*col
        for i in range(row):
            for j in range(col):
                if matrix[i][j] == 0:
                    r[i] = 0
                    c[j] = 0

        for j in range(col):
            for i in range(row):
                matrix[i][j]*=r[i]

        for i in range(row):
            for j in range(col):
                matrix[i][j]*=c[j]
