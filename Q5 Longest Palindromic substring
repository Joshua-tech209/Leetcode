class Solution(object):
    def longestPalindrome(self, s):
        
        if len(s) < 2 or s == s[::-1]:
            return s
            
       
        def expand(left, right):
            
            while left >= 0 and right < len(s) and s[left] == s[right]:
                left -= 1
                right += 1
            
            return s[left + 1 : right]
            
        result = ""
        
        for i in range(len(s)):
            
            sub1 = expand(i, i)
            
            sub2 = expand(i, i + 1)
            
            
            result = max(result, sub1, sub2, key=len)
            
        return result
