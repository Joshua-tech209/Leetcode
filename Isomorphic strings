class Solution(object):
    def isIsomorphic(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """
        mappings = {}
        mappingt = {}
        for i in range(len(s)):
            if s[i] in mappings and mappings[s[i]] != t[i]:
                return False
            if t[i] in mappingt and mappingt[t[i]] != s[i]:
                return False
            
            mappings[s[i]] = t[i]
            mappingt[t[i]] = s[i]

        return True
