class Solution(object):
    def lengthOfLongestSubstring(self, s):
        """
        :type s: str
        :rtype: int
        """
        if len(s) <= 1:
            return len(s)
        front = 0
        longest = 0
        seen = set()
        for back in range(len(s)):
            
            while s[back] in seen:
                
                seen.remove(s[front])
                front += 1
                
            
            seen.add(s[back])
            
           
            longest = max(longest, back - front + 1)
        return longest
